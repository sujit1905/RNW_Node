<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Movie</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            min-height: 100vh;
            padding: 40px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 900px;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 30px;
            text-decoration: none;
        }

        .back-btn {
            padding: 10px 20px;
            background: rgba(102, 126, 234, 0.8);
            color: white;
            border: 1px solid rgba(102, 126, 234, 1);
            border-radius: 6px;
            font-size: 0.95em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: linear-gradient(135deg, #667eea, #764ba2);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #e91e63, #ff6090);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header p {
            color: #aaa;
            font-size: 1em;
        }

        .form-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .form-section {
            margin-bottom: 30px;
        }

        .form-section h3 {
            font-size: 1.3em;
            margin-bottom: 20px;
            color: #ff6090;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            margin-bottom: 8px;
            font-size: 0.95em;
            color: #ddd;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            padding: 12px 15px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #e91e63;
            background: rgba(233, 30, 99, 0.1);
            box-shadow: 0 0 10px rgba(233, 30, 99, 0.3);
        }

        .form-group input::placeholder {
            color: #888;
        }

        .image-preview {
            margin-top: 20px;
            text-align: center;
        }

        .image-preview p {
            color: #aaa;
            margin-bottom: 15px;
            font-size: 0.95em;
        }

        .image-preview img {
            max-width: 300px;
            height: 400px;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            object-fit: cover;
            box-shadow: 0 10px 40px rgba(233, 30, 99, 0.2);
        }

        .button-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 14px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-update {
            background: linear-gradient(135deg, #e91e63, #ff6090);
            color: white;
            box-shadow: 0 5px 20px rgba(233, 30, 99, 0.4);
        }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(233, 30, 99, 0.6);
        }

        .btn-update:active {
            transform: translateY(0);
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8em;
            }

            .form-container {
                padding: 25px;
            }

            .image-preview img {
                max-width: 200px;
                height: 280px;
            }

            .button-group {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Back Navigation Button -->
        <a href="/" class="back-link">
            <button class="back-btn">← Back to Movies</button>
        </a>

        <!-- Page Header -->
        <div class="header">
            <h1>✎ Edit Movie</h1>
            <p>Update your movie details</p>
        </div>

        <!-- Edit Form Container -->
        <div class="form-container">
            <form action="/update/<%= movie._id %>" method="POST" enctype="multipart/form-data">
                
                <!-- Movie Information Section -->
                <div class="form-section">
                    <h3>Movie Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="title">Movie Title *</label>
                            <input type="text" id="title" name="title" value="<%= movie.title %>" required>
                        </div>

                        <div class="form-group">
                            <label for="year">Release Year *</label>
                            <input type="number" id="year" name="year" value="<%= movie.year %>" required min="1900" max="2099">
                        </div>

                        <div class="form-group">
                            <label for="type">Genre/Type *</label>
                            <input type="text" id="type" name="type" value="<%= movie.type %>" required>
                        </div>
                    </div>
                </div>

                <!-- Movie Poster Section -->
                <div class="form-section">
                    <h3>Movie Poster</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="img">Change Movie Image (Optional)</label>
                            <input type="file" id="img" name="img" accept="image/*">
                            <small style="color: #888; margin-top: 5px;">Leave empty to keep current image</small>
                        </div>
                    </div>

                    <!-- Current Movie Image Preview -->
                    <div class="image-preview">
                        <p>Current Movie Poster:</p>
                        <img src="/uploads/<%= movie.img %>" alt="<%= movie.title %>" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22400%22%3E%3Crect fill=%22%23333%22 width=%22300%22 height=%22400%22/%3E%3C/svg%3E'">
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="button-group">
                    <button type="submit" class="btn btn-update">✓ Update Movie</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
