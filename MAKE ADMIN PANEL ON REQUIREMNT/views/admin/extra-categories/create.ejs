<% // Form for creating a new extra category linked to a category and subcategory. %>
<% const breadcrumbs = [{ label: 'Dashboard', url: '/admin/dashboard' }, { label: 'Extra Categories', url: '/admin/extra-categories' }, { label: 'Add New' }] %>

<%- include('../../partials/breadcrumb', { breadcrumbs }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Add Extra Category</h1>
  </div>
</div>

<div class="nv-card nv-card-form">
  <form action="/admin/extra-categories" method="POST" class="nv-form" data-loading data-cascade>
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control nv-input" name="name" required>
      </div>
      <div class="col-md-6">
        <label class="form-label">Category <span class="text-danger">*</span></label>
        <select class="form-select nv-input" name="category" id="categorySelect" required>
          <option value="">Select category</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c._id %>"><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Subcategory <span class="text-danger">*</span></label>
        <select class="form-select nv-input" name="subcategory" id="subcategorySelect" required disabled>
          <option value="">Select subcategory</option>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Status</label>
        <select class="form-select nv-input" name="isActive">
          <option value="true" selected>Active</option>
          <option value="false">Inactive</option>
        </select>
      </div>
      <div class="col-12">
        <label class="form-label">Description</label>
        <textarea class="form-control nv-input" name="description" rows="3"></textarea>
      </div>
    </div>
    <div class="form-actions">
      <a href="/admin/extra-categories" class="btn btn-outline-light">Cancel</a>
      <button type="submit" class="btn btn-primary nv-btn"><span class="btn-text">Save</span><span class="btn-loader d-none"><span class="spinner-border spinner-border-sm"></span></span></button>
    </div>
  </form>
</div>
