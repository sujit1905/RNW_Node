<% // Detailed view page for an extra category and its related values. %>
<% const breadcrumbs = [{ label: 'Dashboard', url: '/admin/dashboard' }, { label: 'Extra Categories', url: '/admin/extra-categories' }, { label: item.name }] %>

<%- include('../../partials/breadcrumb', { breadcrumbs }) %>

<div class="page-header">
  <div><h1 class="page-title"><%= item.name %></h1></div>
  <div class="d-flex gap-2">
    <a href="/admin/extra-categories/<%= item._id %>/edit" class="btn btn-outline-light"><i class="bi bi-pencil me-1"></i>Edit</a>
    <form action="/admin/extra-categories/<%= item._id %>?_method=DELETE" method="POST" data-confirm="Delete this extra category?">
      <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
    </form>
  </div>
</div>

<div class="nv-card">
  <div class="detail-grid">
    <div class="detail-item"><span class="detail-label">Name</span><span class="detail-value"><%= item.name %></span></div>
    <div class="detail-item"><span class="detail-label">Category</span><span class="detail-value"><%= item.category ? item.category.name : '—' %></span></div>
    <div class="detail-item"><span class="detail-label">Subcategory</span><span class="detail-value"><%= item.subcategory ? item.subcategory.name : '—' %></span></div>
    <div class="detail-item"><span class="detail-label">Status</span><span class="detail-value"><span class="badge <%= item.isActive ? 'bg-success' : 'bg-secondary' %>"><%= item.isActive ? 'Active' : 'Inactive' %></span></span></div>
    <div class="detail-item detail-item-full"><span class="detail-label">Description</span><span class="detail-value"><%= item.description || 'No description' %></span></div>
  </div>
</div>
