<% // Main listing page for extra categories with actions and pagination. %>
<% const breadcrumbs = [{ label: 'Dashboard', url: '/admin/dashboard' }, { label: 'Extra Categories' }] %>

<%- include('../../partials/breadcrumb', { breadcrumbs }) %>

<div class="page-header">
  <div>
    <h1 class="page-title">Extra Categories</h1>
    <p class="page-desc">Third-level category classification</p>
  </div>
  <a href="/admin/extra-categories/create" class="btn btn-primary nv-btn"><i class="bi bi-plus-lg me-1"></i>Add Extra Category</a>
</div>

<div class="nv-card">
  <div class="nv-card-header">
    <form action="/admin/extra-categories" method="GET" class="search-form">
      <div class="search-input-wrap">
        <i class="bi bi-search"></i>
        <input type="text" name="search" class="form-control nv-input" placeholder="Search..." value="<%= search %>">
      </div>
      <button type="submit" class="btn btn-outline-light btn-sm">Search</button>
    </form>
  </div>
  <div class="table-responsive">
    <table class="table nv-table mb-0">
      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Category</th>
          <th>Subcategory</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (items.length) { %>
          <% items.forEach(function(item, i) { %>
            <tr>
              <td><%= (pagination.currentPage - 1) * 10 + i + 1 %></td>
              <td><a href="/admin/extra-categories/<%= item._id %>" class="table-link" style="color: rgb(53, 15, 205);"><%= item.name %></a></td>
              <td><%= item.category ? item.category.name : '—' %></td>
              <td><%= item.subcategory ? item.subcategory.name : '—' %></td>
              <td><span class="badge <%= item.isActive ? 'bg-success' : 'bg-secondary' %>"><%= item.isActive ? 'Active' : 'Inactive' %></span></td>
              <td class="text-end">
                <div class="action-btns">
                  <a href="/admin/extra-categories/<%= item._id %>" class="action-btn"><i class="bi bi-eye"></i></a>
                  <a href="/admin/extra-categories/<%= item._id %>/edit" class="action-btn"><i class="bi bi-pencil"></i></a>
                  <form action="/admin/extra-categories/<%= item._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete this extra category?">
                    <button type="submit" class="action-btn action-btn-danger"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="6" class="text-center text-muted py-5">No extra categories found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="nv-card-footer"><%- include('../../partials/pagination', { pagination }) %></div>
</div>
