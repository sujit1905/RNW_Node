<% // Detailed view page for a single category entry. %>
<% const breadcrumbs = [{ label: 'Dashboard', url: '/admin/dashboard' }, { label: 'Categories', url: '/admin/categories' }, { label: category.name }] %>

<%- include('../../partials/breadcrumb', { breadcrumbs }) %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= category.name %></h1>
    <p class="page-desc">Category details</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/categories/<%= category._id %>/edit" class="btn btn-outline-light"><i class="bi bi-pencil me-1"></i>Edit</a>
    <form action="/admin/categories/<%= category._id %>?_method=DELETE" method="POST" data-confirm="Delete this category?">
      <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
    </form>
  </div>
</div>

<div class="nv-card">
  <div class="detail-grid">
    <div class="detail-item">
      <span class="detail-label">Name</span>
      <span class="detail-value"><%= category.name %></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Slug</span>
      <span class="detail-value"><code class="slug-code"><%= category.slug %></code></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Status</span>
      <span class="detail-value"><span class="badge <%= category.isActive ? 'bg-success' : 'bg-secondary' %>"><%= category.isActive ? 'Active' : 'Inactive' %></span></span>
    </div>
    <div class="detail-item">
      <span class="detail-label">Created</span>
      <span class="detail-value"><%= new Date(category.createdAt).toLocaleString() %></span>
    </div>
    <div class="detail-item detail-item-full">
      <span class="detail-label">Description</span>
      <span class="detail-value"><%= category.description || 'No description provided' %></span>
    </div>
  </div>
</div>
