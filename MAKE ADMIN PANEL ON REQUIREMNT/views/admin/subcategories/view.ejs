<% // Detailed view page for one subcategory with its parent category and status. %>
<% const breadcrumbs = [{ label: 'Dashboard', url: '/admin/dashboard' }, { label: 'Subcategories', url: '/admin/subcategories' }, { label: subcategory.name }] %>

<%- include('../../partials/breadcrumb', { breadcrumbs }) %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= subcategory.name %></h1>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/subcategories/<%= subcategory._id %>/edit" class="btn btn-outline-light"><i class="bi bi-pencil me-1"></i>Edit</a>
    <form action="/admin/subcategories/<%= subcategory._id %>?_method=DELETE" method="POST" data-confirm="Delete this subcategory?">
      <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
    </form>
  </div>
</div>

<div class="nv-card">
  <div class="detail-grid">
    <div class="detail-item"><span class="detail-label">Name</span><span class="detail-value"><%= subcategory.name %></span></div>
    <div class="detail-item"><span class="detail-label">Category</span><span class="detail-value"><%= subcategory.category ? subcategory.category.name : '—' %></span></div>
    <div class="detail-item"><span class="detail-label">Slug</span><span class="detail-value"><code class="slug-code"><%= subcategory.slug %></code></span></div>
    <div class="detail-item"><span class="detail-label">Status</span><span class="detail-value"><span class="badge <%= subcategory.isActive ? 'bg-success' : 'bg-secondary' %>"><%= subcategory.isActive ? 'Active' : 'Inactive' %></span></span></div>
    <div class="detail-item detail-item-full"><span class="detail-label">Description</span><span class="detail-value"><%= subcategory.description || 'No description' %></span></div>
  </div>
</div>
