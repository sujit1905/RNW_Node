<!-- Password recovery form that sends an OTP to the registered email address -->
<h2 class="auth-title">Forgot password</h2>
<p class="auth-subtitle">We'll send a 6-digit OTP to your email</p>

<form action="/auth/forgot-password" method="POST" class="nv-form" data-loading>
  <div class="form-floating mb-4">
    <input type="email" class="form-control" id="email" name="email" placeholder="Email" required>
    <label for="email"><i class="bi bi-envelope me-2"></i>Registered email</label>
  </div>
  <button type="submit" class="btn btn-primary w-100 nv-btn">
    <span class="btn-text">Send OTP</span>
    <span class="btn-loader d-none"><span class="spinner-border spinner-border-sm"></span></span>
  </button>
</form>

<div class="auth-links">
  <a href="/auth/login"><i class="bi bi-arrow-left me-1"></i>Back to login</a>
</div>
