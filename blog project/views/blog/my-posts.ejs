<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">My Dashboard</h2>
            <p class="text-muted mb-0">Manage your published articles and drafts</p>
        </div>
        <a href="/blog/create" class="btn btn-primary btn-lg">
            <i class="fas fa-pen-to-square me-2"></i>Write New Post
        </a>
    </div>

    <!-- Quick Stats -->
    <% 
        let totalViews = 0; 
        let totalLikes = 0; 
        posts.forEach(post => { 
            totalViews += post.views || 0; 
            totalLikes += post.likes ? post.likes.length : 0; 
        }); 
    %>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <div class="display-6 fw-bold text-primary mb-1"><%= posts.length %></div>
                <div class="text-uppercase fw-bold small text-muted">Total Posts</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <div class="display-6 fw-bold text-success mb-1"><%= totalViews %></div>
                <div class="text-uppercase fw-bold small text-muted">Total Views</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <div class="display-6 fw-bold text-info mb-1"><%= totalLikes %></div>
                <div class="text-uppercase fw-bold small text-muted">Total Likes</div>
            </div>
        </div>
    </div>

    <!-- Posts Table/List -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <% if (posts.length === 0) { %>
                <div class="text-center py-5">
                    <i class="fas fa-folder-open mb-3" style="font-size: 3.5rem; color: #dee2e6;"></i>
                    <h4 class="text-muted fw-bold">No posts found</h4>
                    <p class="text-muted mb-4">You haven't written any blog posts yet.</p>
                    <a href="/blog/create" class="btn btn-outline-primary">Write your first post!</a>
                </div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-muted small text-uppercase fw-bold border-bottom">
                                <th scope="col" style="min-width: 250px;">Title</th>
                                <th scope="col">Date Created</th>
                                <th scope="col">Status</th>
                                <th scope="col">Stats</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% posts.forEach(post => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><%= post.title %></div>
                                        <span class="badge bg-light text-muted border mt-1"><%= post.category %></span>
                                    </td>
                                    <td class="text-muted small">
                                        <%= new Date(post.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </td>
                                    <td>
                                        <% if (post.status === 'published') { %>
                                            <span class="badge bg-success-subtle text-success px-3 py-2">Published</span>
                                        <% } else { %>
                                            <span class="badge bg-warning-subtle text-warning px-3 py-2">Draft</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-3 text-muted small">
                                            <span><i class="fas fa-eye me-1"></i><%= post.views %></span>
                                            <span><i class="fas fa-heart me-1"></i><%= post.likes.length %></span>
                                            <span><i class="fas fa-comment me-1"></i><%= post.comments.length %></span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a href="/blog/post/<%= post.slug %>" class="btn btn-sm btn-outline-secondary" title="View Post">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="/blog/edit/<%= post.slug %>" class="btn btn-sm btn-outline-primary" title="Edit Post">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form method="POST" action="/blog/delete/<%= post.slug %>" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Post">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
