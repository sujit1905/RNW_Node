<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-4"><i class="fas fa-edit text-primary me-2"></i>Edit Post</h2>

                    <% if (locals.error) { %>
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i><%= error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <form action="/blog/edit/<%= post.slug %>" method="POST" id="postForm" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label for="title" class="form-label fw-bold small text-muted text-uppercase">Post Title</label>
                            <input type="text" class="form-control form-control-lg border-2" id="title" name="title" value="<%= post.title %>" required maxlength="200">
                            <div class="invalid-feedback">Please provide a title for your post.</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label for="category" class="form-label fw-bold small text-muted text-uppercase">Category</label>
                                <select class="form-select form-select-lg border-2" id="category" name="category">
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat %>" <%= post.category === cat ? 'selected' : '' %>><%= cat %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label for="status" class="form-label fw-bold small text-muted text-uppercase">Status</label>
                                <select class="form-select form-select-lg border-2" id="status" name="status">
                                    <option value="published" <%= post.status === 'published' ? 'selected' : '' %>>Published</option>
                                    <option value="draft" <%= post.status === 'draft' ? 'selected' : '' %>>Draft</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="featuredImage" class="form-label fw-bold small text-muted text-uppercase">Featured Image (Upload to Change)</label>
                                <input type="file" class="form-control form-control-lg border-2" id="featuredImage" name="featuredImage" accept="image/*">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="excerpt" class="form-label fw-bold small text-muted text-uppercase">Excerpt / Summary</label>
                            <textarea class="form-control border-2" id="excerpt" name="excerpt" rows="2" placeholder="Brief summary of the post..." maxlength="500"><%= post.excerpt %></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted text-uppercase">Post Content</label>
                            <div id="editor" style="height: 350px;" class="border-2 rounded"></div>
                            <input type="hidden" name="content" id="content" required>
                            <div class="invalid-feedback d-block" id="contentFeedback" style="display: none;">Please write some content.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                Save Changes <i class="fas fa-save ms-2"></i>
                            </button>
                            <a href="/blog/post/<%= post.slug %>" class="btn btn-outline-secondary btn-lg px-4">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script>
// Initialize Quill Editor
var quill = new Quill('#editor', {
    theme: 'snow',
    placeholder: 'Write your story here...',
    modules: {
        toolbar: [
            [{ 'header': [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            ['blockquote', 'code-block'],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            ['link', 'image'],
            ['clean']
        ]
    }
});

// Load existing post content into Quill editor
quill.root.innerHTML = `<%- post.content %>`;

// Update the hidden input on submit
var form = document.getElementById('postForm');
var contentInput = document.getElementById('content');
var feedback = document.getElementById('contentFeedback');

form.addEventListener('submit', function(e) {
    // Get HTML content from Quill
    var html = quill.root.innerHTML;
    // Check if empty
    var text = quill.getText().trim();
    
    if (!text) {
        e.preventDefault();
        feedback.style.display = 'block';
        return;
    }
    
    feedback.style.display = 'none';
    contentInput.value = html;
});
</script>
