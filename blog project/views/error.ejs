<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow p-5">
                <div class="card-body">
                    <div class="mb-4 text-danger">
                        <i class="fas fa-circle-exclamation fa-5x animate-pulse"></i>
                    </div>
                    <h1 class="fw-bold mb-3">Something Went Wrong</h1>
                    <p class="text-muted mb-4">We encountered an internal server error while processing your request. Please try again later.</p>
                    
                    <% if (locals.message) { %>
                        <div class="bg-light p-3 rounded text-start mb-4 font-monospace small border text-danger">
                            <strong>Details:</strong> <%= message %>
                        </div>
                    <% } %>

                    <div class="d-flex justify-content-center gap-2">
                        <a href="/blog" class="btn btn-primary btn-lg">
                            <i class="fas fa-home me-2"></i>Go Back Home
                        </a>
                        <button onclick="location.reload()" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-rotate me-2"></i>Retry
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
