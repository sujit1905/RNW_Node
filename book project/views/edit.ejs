<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            min-height: 100vh;
            padding: 40px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 900px;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 30px;
            text-decoration: none;
        }

        .back-btn {
            padding: 10px 20px;
            background: rgba(102, 126, 234, 0.8);
            color: white;
            border: 1px solid rgba(102, 126, 234, 1);
            border-radius: 6px;
            font-size: 0.95em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: linear-gradient(135deg, #667eea, #764ba2);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header p {
            color: #aaa;
            font-size: 1em;
        }

        .form-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .form-section {
            margin-bottom: 30px;
        }

        .form-section h3 {
            font-size: 1.3em;
            margin-bottom: 20px;
            color: #667eea;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            margin-bottom: 8px;
            font-size: 0.95em;
            color: #ddd;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            padding: 12px 15px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #667eea;
            background: rgba(102, 126, 234, 0.1);
            box-shadow: 0 0 10px rgba(102, 126, 234, 0.3);
        }

        .form-group input::placeholder {
            color: #888;
        }

        .image-preview {
            margin-top: 20px;
            text-align: center;
        }

        .image-preview p {
            color: #aaa;
            margin-bottom: 15px;
            font-size: 0.95em;
        }

        .image-preview img {
            max-width: 300px;
            height: 400px;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            object-fit: cover;
            box-shadow: 0 10px 40px rgba(102, 126, 234, 0.2);
        }

        .button-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 14px 30px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-update {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-update:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(102, 126, 234, 0.6);
        }

        .btn-update:active {
            transform: translateY(0);
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8em;
            }

            .form-container {
                padding: 25px;
            }

            .image-preview img {
                max-width: 200px;
                height: 280px;
            }

            .button-group {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">
            <button class="back-btn">← Back to Books</button>
        </a>

        <div class="header">
            <h1>✎ Edit Book</h1>
            <p>Update your book details</p>
        </div>

        <div class="form-container">
            <form action="/update/<%= book._id %>" method="POST" enctype="multipart/form-data">
                
                <div class="form-section">
                    <h3>Book Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="title">Book Title *</label>
                            <input type="text" id="title" name="title" value="<%= book.title %>" required>
                        </div>

                        <div class="form-group">
                            <label for="author">Author *</label>
                            <input type="text" id="author" name="author" value="<%= book.author %>" required>
                        </div>

                        <div class="form-group">
                            <label for="price">Price *</label>
                            <input type="number" id="price" name="price" value="<%= book.price %>" required step="0.01">
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3>Book Cover</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="image">Change Book Cover (Optional)</label>
                            <input type="file" id="image" name="image" accept="image/*">
                            <small style="color: #888; margin-top: 5px;">Leave empty to keep current cover</small>
                        </div>
                    </div>

                    <div class="image-preview">
                        <p>Current Book Cover:</p>
                        <img src="/uploads/<%= book.image %>" alt="<%= book.title %>" onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22400%22%3E%3Crect fill=%22%23333%22 width=%22300%22 height=%22400%22/%3E%3C/svg%3E'">
                    </div>
                </div>

                <div class="button-group">
                    <button type="submit" class="btn btn-update">✓ Update Book</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
        color: #8888aa;
      }

      .preview-info .p-price {
        font-size: 16px;
        font-weight: 700;
        color: #a78bfa;
        margin-top: 6px;
      }

      /* ── Edit Form ── */
      .edit-card {
        background: #1a1a2e;
        border: 1px solid #ffffff10;
        border-radius: 16px;
        padding: 30px 32px;
      }

      .edit-card h2 {
        font-size: 16px;
        font-weight: 600;
        color: #a0a0b0;
        margin-bottom: 22px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      .form-grid .full { grid-column: 1 / -1; }

      .form-group { display: flex; flex-direction: column; gap: 6px; }

      .form-group label {
        font-size: 13px;
        font-weight: 500;
        color: #8888aa;
      }

      .form-group input[type="text"],
      .form-group input[type="number"] {
        background: #0f0f1a;
        border: 1px solid #2a2a40;
        border-radius: 8px;
        padding: 10px 14px;
        color: #e2e2e8;
        font-size: 14px;
        font-family: inherit;
        transition: border-color 0.2s;
        outline: none;
      }

      .form-group input[type="text"]:focus,
      .form-group input[type="number"]:focus {
        border-color: #7c3aed;
      }

      /* File input */
      .file-label {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #0f0f1a;
        border: 1px dashed #3a3a55;
        border-radius: 8px;
        padding: 12px 16px;
        cursor: pointer;
        transition: border-color 0.2s;
        font-size: 14px;
        color: #8888aa;
      }

      .file-label:hover { border-color: #7c3aed; color: #c4b5fd; }
      .file-label input[type="file"] { display: none; }
      #file-name { font-size: 13px; color: #6060aa; }

      /* Buttons */
      .btn-row {
        display: flex;
        gap: 12px;
        margin-top: 22px;
      }

      .btn-save {
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 11px 28px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.2s, transform 0.15s;
      }

      .btn-save:hover { opacity: 0.9; transform: translateY(-1px); }
      .btn-save:active { transform: translateY(0); }

      .btn-cancel {
        background: transparent;
        border: 1px solid #2a2a40;
        color: #8888aa;
        border-radius: 8px;
        padding: 11px 22px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: border-color 0.2s, color 0.2s;
      }

      .btn-cancel:hover { border-color: #4a4a70; color: #c0c0d8; }

      /* ── Responsive ── */
      @media (max-width: 600px) {
        header { padding: 14px 20px; }
        main { padding: 24px 16px; }
        .form-grid { grid-template-columns: 1fr; }
        .form-grid .full { grid-column: 1; }
        .edit-card { padding: 20px 18px; }
        .preview-card { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>

  <body>

    <!-- Header -->
    <header>
      <span class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </span>
      <h1>Book Library</h1>
    </header>

    <main>

      <a href="/" class="back-link">← Back to Library</a>

      <!-- Current book preview -->
      <div class="preview-card">
        <img src="/uploads/<%= book.image %>" alt="<%= book.title %>" />
        <div class="preview-info">
          <span class="tag">Current Details</span>
          <p class="p-title"><%= book.title %></p>
          <p class="p-author">by <%= book.author %></p>
          <p class="p-price">₹<%= book.price %></p>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="edit-card">
        <h2>Update Book</h2>
        <form action="/update/<%= book._id %>" method="post" enctype="multipart/form-data">
          <div class="form-grid">

            <div class="form-group">
              <label for="title">Book Title</label>
              <input type="text" name="title" id="title" value="<%= book.title %>" required />
            </div>

            <div class="form-group">
              <label for="author">Author</label>
              <input type="text" name="author" id="author" value="<%= book.author %>" required />
            </div>

            <div class="form-group">
              <label for="price">Price (₹)</label>
              <input type="number" name="price" id="price" value="<%= book.price %>" min="0" required />
            </div>

            <!-- File picker -->
            <div class="form-group full">
              <label>Replace Cover Image <span style="color:#505070;">(optional)</span></label>
              <label class="file-label" for="image">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Choose new image
                <span id="file-name">No file chosen</span>
                <input type="file" name="image" id="image" accept="image/*" />
              </label>
            </div>

          </div>

          <div class="btn-row">
            <button type="submit" class="btn-save">Save Changes</button>
            <a href="/" class="btn-cancel">Cancel</a>
          </div>

        </form>
      </div>

    </main>

    <!-- Update file-name label on file pick -->
    <script>
      document.getElementById("image").addEventListener("change", function () {
        const name = this.files[0] ? this.files[0].name : "No file chosen";
        document.getElementById("file-name").textContent = name;
      });
    </script>

  </body>
</html>
