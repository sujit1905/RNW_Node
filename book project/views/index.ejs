<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Library</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* ── Reset & Base ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: "Inter", sans-serif;
        background: #0f0f13;
        color: #e2e2e8;
        min-height: 100vh;
      }

      /* ── Header ── */
      header {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border-bottom: 1px solid #ffffff12;
        padding: 18px 40px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      header .logo-icon {
        font-size: 26px;
      }

      header h1 {
        font-size: 22px;
        font-weight: 700;
        background: linear-gradient(90deg, #a78bfa, #60a5fa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.3px;
      }

      /* ── Main Layout ── */
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 24px;
      }

      /* ── Upload Card ── */
      .upload-card {
        background: #1a1a2e;
        border: 1px solid #ffffff10;
        border-radius: 16px;
        padding: 30px 32px;
        margin-bottom: 48px;
      }

      .upload-card h2 {
        font-size: 16px;
        font-weight: 600;
        color: #a0a0b0;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      /* File input spans full width */
      .form-grid .full {
        grid-column: 1 / -1;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .form-group label {
        font-size: 13px;
        font-weight: 500;
        color: #8888aa;
      }

      .form-group input[type="text"],
      .form-group input[type="number"] {
        background: #0f0f1a;
        border: 1px solid #2a2a40;
        border-radius: 8px;
        padding: 10px 14px;
        color: #e2e2e8;
        font-size: 14px;
        font-family: inherit;
        transition: border-color 0.2s;
        outline: none;
      }

      .form-group input[type="text"]:focus,
      .form-group input[type="number"]:focus {
        border-color: #7c3aed;
      }

      /* Custom file input */
      .file-label {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #0f0f1a;
        border: 1px dashed #3a3a55;
        border-radius: 8px;
        padding: 12px 16px;
        cursor: pointer;
        transition: border-color 0.2s;
        font-size: 14px;
        color: #8888aa;
      }

      .file-label:hover { border-color: #7c3aed; color: #c4b5fd; }

      .file-label input[type="file"] { display: none; }

      #file-name { font-size: 13px; color: #6060aa; }

      .btn-submit {
        margin-top: 6px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 11px 28px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.15s;
        font-family: inherit;
      }

      .btn-submit:hover { opacity: 0.9; transform: translateY(-1px); }
      .btn-submit:active { transform: translateY(0); }

      /* ── Section Heading ── */
      .section-heading {
        font-size: 18px;
        font-weight: 700;
        color: #c4c4d4;
        margin-bottom: 24px;
      }

      /* ── Books Grid ── */
      .books-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 22px;
      }

      /* Empty state */
      .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #505070;
      }

      .empty-state .empty-icon { margin-bottom: 16px; }
      .empty-state p { font-size: 15px; }

      /* ── Book Card ── */
      .book-card {
        background: #1a1a2e;
        border: 1px solid #ffffff0d;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .book-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px #00000060;
      }

      .book-cover {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: #111124;
        display: block;
      }

      .book-info {
        padding: 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .book-title {
        font-size: 15px;
        font-weight: 700;
        color: #e2e2ee;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .book-author {
        font-size: 13px;
        color: #8888aa;
      }

      .book-price {
        font-size: 16px;
        font-weight: 700;
        color: #a78bfa;
        margin-top: 8px;
      }

      /* Card actions */
      .card-actions {
        display: flex;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid #ffffff08;
      }

      .btn-edit {
        flex: 1;
        text-align: center;
        background: #1e1e38;
        border: 1px solid #3a3a60;
        color: #a0a0cc;
        border-radius: 7px;
        padding: 8px 0;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
      }

      .btn-edit:hover {
        background: #2a2a50;
        color: #c4b5fd;
      }

      .btn-delete {
        flex: 1;
        background: #1e1010;
        border: 1px solid #3a1818;
        color: #cc6666;
        border-radius: 7px;
        padding: 8px 0;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        transition: background 0.2s, color 0.2s;
      }

      .btn-delete:hover {
        background: #2a1010;
        color: #f87171;
      }

      /* ── Responsive ── */
      @media (max-width: 600px) {
        header { padding: 14px 20px; }
        main { padding: 24px 16px; }
        .form-grid { grid-template-columns: 1fr; }
        .form-grid .full { grid-column: 1; }
        .upload-card { padding: 20px 18px; }
      }
    </style>
  </head>

  <body>

    <!-- Header -->
    <header>
      <!-- book icon -->
      <span class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </span>
      <h1>Book Library</h1>
    </header>

    <main>

      <!-- Upload Form -->
      <div class="upload-card">
        <h2>Add New Book</h2>
        <form action="/uploads" method="post" enctype="multipart/form-data">
          <div class="form-grid">

            <div class="form-group">
              <label for="title">Book Title</label>
              <input type="text" name="title" id="title" placeholder="e.g. The Alchemist" required />
            </div>

            <div class="form-group">
              <label for="author">Author</label>
              <input type="text" name="author" id="author" placeholder="e.g. Paulo Coelho" required />
            </div>

            <div class="form-group">
              <label for="price">Price (₹)</label>
              <input type="number" name="price" id="price" placeholder="e.g. 299" min="0" required />
            </div>

            <!-- File picker -->
            <div class="form-group full">
              <label>Cover Image</label>
              <label class="file-label" for="image">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Choose image file
                <span id="file-name">No file chosen</span>
                <input type="file" name="image" id="image" accept="image/*" required />
              </label>
            </div>

          </div>

          <br />
          <button type="submit" class="btn-submit">Upload Book</button>
        </form>
      </div>

      <!-- Book List -->
      <p class="section-heading">All Books</p>

      <% if (book.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#303050" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <p>No books yet. Add your first book above!</p>
        </div>
      <% } else { %>
        <div class="books-grid">
          <% book.forEach((item) => { %>
            <div class="book-card">
              <img class="book-cover" src="/uploads/<%= item.image %>" alt="<%= item.title %>" />
              <div class="book-info">
                <p class="book-title"><%= item.title %></p>
                <p class="book-author">by <%= item.author %></p>
                <p class="book-price">₹<%= item.price %></p>
              </div>
              <div class="card-actions">
                <a href="/edit/<%= item._id %>" class="btn-edit">
                  <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                  Edit
                </a>
                <form action="/delete/<%= item._id %>" method="post" style="flex:1; display:flex;">
                  <button type="submit" class="btn-delete" style="width:100%;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                    Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </main>

    <!-- Update file-name label on file pick -->
    <script>
      document.getElementById("image").addEventListener("change", function () {
        const name = this.files[0] ? this.files[0].name : "No file chosen";
        document.getElementById("file-name").textContent = name;
      });
    </script>

  </body>
</html>